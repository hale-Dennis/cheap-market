# Copy to .env to override the docker-compose.yml defaults. All values are for local development only.

# Postgres credentials (used by both the db and api services).
DB_USER=cheap_market
DB_PASSWORD=cheap_market

# Base64-encoded HMAC key (at least 32 bytes decoded). Shared by the api and web services.
# Generate one with: openssl rand -base64 48
JWT_SECRET=bG9jYWwtZGV2LW9ubHktand0LXNlY3JldC1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=

# Admin account seeded on first API start-up.
ADMIN_USERNAME=admin@default.com
ADMIN_PASSWORD=defaultpassword
